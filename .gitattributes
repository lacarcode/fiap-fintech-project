# Normaliza finais de linha no repositório (LF), convertendo no checkout do Windows quando aplicável
* text=auto

# Scripts shell SEMPRE com LF (CRLF quebra o bash: "$'\r': command not found")
*.sh text eol=lf

# Binários
*.pdf  binary
*.png  binary
*.docx binary
*.class binary

# Maven Wrapper: script sh sempre LF; scripts Windows sempre CRLF
mvnw  text eol=lf
*.cmd text eol=crlf
