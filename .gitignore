# Java build output
backend/out/
*.class

# IntelliJ IDEA (keep shared project files, ignore user-specific ones)
.idea/workspace.xml
.idea/shelf/
**/.idea/workspace.xml
**/.idea/shelf/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp

# Database credentials (never versioned — see database/.env.example)
database/.env.local
*.credentials
.env
.env.*
!.env.example

# Python caches (document generator)
__pycache__/
*.pyc

# Credenciais de conexao do backend (modelo: backend/db.properties.example)
backend/db.properties

# Fase 8 — API Spring Boot (api/) e SPA React (web/)
api/target/
api/application-local.properties
web/node_modules/
web/dist/
web/.env.local
